# Copier dans .env et adapter. Jamais de secret en clair ici.
DJANGO_ALLOWED_HOSTS=athcalendar.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://athcalendar.example.org
# Adresses des proxies autorisés à transmettre X-Forwarded-For (sinon laisser vide).
DJANGO_TRUSTED_PROXIES=
# Parcours B uniquement :
APP_DOMAIN=athcalendar.example.org
PROXY_NETWORK=
# Le secret Django est fourni via ./secrets/django_secret_key.txt (non commité).
